[Unit]
Description=vram-pool: one OpenAI-compatible endpoint over every device's VRAM (127.0.0.1:8100)
Documentation=https://github.com/thefiredev-cloud/vram-pool
After=network-online.target

[Service]
Type=simple
ExecStart=%h/.local/bin/vram-pool --config %h/.config/vram-pool/pool.toml
Environment=RUST_LOG=vram_pool=info
Restart=on-failure
RestartSec=3
# Sandboxing is limited to options that need no mount namespace. In a user unit, ProtectSystem,
# ProtectHome and PrivateTmp run inside a user namespace where root-owned /etc files look
# owned by nobody, and ssh then refuses /etc/ssh/ssh_config.d/* ("Bad owner or permissions").
NoNewPrivileges=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
LockPersonality=yes

[Install]
WantedBy=default.target
